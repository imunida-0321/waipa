{
	"name": "waipa",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"overrides": {
		"uuid": "^11.1.1"
	},
	"dependencies": {
		"@expo/ui": "~58.0.27",
		"@expo/vector-icons": "^15.0.2",
		"@lottiefiles/dotlottie-react": "^0.19.7",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-three/fiber": "^9.8.2",
		"expo": "~58.0.23",
		"expo-asset": "~58.0.20",
		"expo-audio": "~58.0.11",
		"expo-blur": "~58.0.5",
		"expo-constants": "~58.0.15",
		"expo-device": "~58.0.5",
		"expo-file-system": "~58.0.13",
		"expo-font": "~58.0.11",
		"expo-gl": "~58.0.4",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.16",
		"expo-router": "~58.0.30",
		"expo-sensors": "~58.0.4",
		"expo-splash-screen": "~58.0.13",
		"expo-status-bar": "~58.0.4",
		"expo-store-review": "~58.0.2",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"expo-tracking-transparency": "~58.0.2",
		"expo-web-browser": "~58.0.7",
		"lottie-react-native": "~7.5.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-google-mobile-ads": "^17.4.0",
		"react-native-purchases": "^10.4.3",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"three": "^0.182.0"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.88.1",
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.0",
		"@types/three": "^0.185.1",
		"eslint": "^9",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.8",
		"jest": "~30.5.2",
		"jest-expo": "~58.0.14",
		"prettier": "^3.9.4",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "expo lint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "jest"
	},
	"jest": {
		"preset": "jest-expo",
		"setupFiles": [
			"<rootDir>/jest.setup.js"
		],
		"collectCoverageFrom": [
			"src/**/*.{ts,tsx}",
			"!src/**/__tests__/**",
			"!src/**/*.d.ts"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"<rootDir>/.claude/"
		],
		"moduleNameMapper": {
			"^@/assets/(.*)$": "<rootDir>/assets/$1",
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?(-.*)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|expo-router|expo-modules-core|react-native-reanimated|react-native-worklets)/)"
		]
	},
	"private": true
}
